{
  "name": "@sightspool/sdk",
  "version": "0.4.0",
  "description": "Sightspool research SDK \u2014 invite website visitors and signed-in users into approved user research.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "site",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Sightspool",
  "homepage": "https://www.sightspool.com/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sightspool/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sightspool/sdk/issues"
  },
  "keywords": [
    "sightspool",
    "user-research",
    "research",
    "interviews",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/build-release.mjs",
    "type-check": "tsc --noEmit",
    "test": "tsc --noEmit && node --test __tests__/*.test.ts",
    "prepublishOnly": "pnpm run build",
    "test:release": "node scripts/verify-release.mjs && node --test scripts/release.test.mjs",
    "build:site": "node scripts/stage-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}

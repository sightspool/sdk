{
  "name": "@sightspool/react",
  "version": "0.1.0",
  "description": "React bindings for the Sightspool in-product capture SDK — a <SightspoolProvider> + hooks over init/identify/consent.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Sightspool",
  "homepage": "https://github.com/sightspool/sdk/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sightspool/sdk.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/sightspool/sdk/issues"
  },
  "keywords": [
    "sightspool",
    "react",
    "nextjs",
    "analytics",
    "product-analytics",
    "user-research",
    "intent",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "node --test __tests__/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@sightspool/sdk": ">=0.1.1 <0.4.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@sightspool/sdk": "workspace:^",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}

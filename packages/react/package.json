{
  "name": "@justusability/react",
  "version": "0.1.0",
  "description": "React bindings for the Justusability research SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Justusability",
  "homepage": "https://research.justusability.com/sdk",
  "keywords": [
    "justusability",
    "research",
    "interviews",
    "sdk",
    "react"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "tsc --noEmit && node --test __tests__/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "@justusability/sdk": ">=0.1.0 <0.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "@justusability/sdk": "workspace:^"
  }
}
